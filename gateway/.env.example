# ─────────────────────────────────────────────────────────────
# 环境变量模板
#
# 用法：
#   cp .env.example .env      # 然后填入真实值
#   npm start                 # 会自动加载 .env（无需 export）
#
# ⚠️ .env 已被 .gitignore 忽略 —— 绝不要提交真实 Key。
# ─────────────────────────────────────────────────────────────

# 高德「Web 服务」类型 Key（申请步骤见 docs/nav-backend.md §3.2）
# 注意：平台的「服务平台」必须选【Web 服务】，选错会返回 10009/10001
AMAP_KEY=

# 客户端访问本网关的令牌（不是高德的东西，自己生成即可）
# 生成：node -e "console.log(crypto.randomUUID())"
GATEWAY_TOKEN=

# 可选（以下为默认值，通常不用改）
# PORT=8080
# RATE_LIMIT_PER_MIN=60
# UPSTREAM_TIMEOUT_MS=8000
# VERBOSE_ERRORS=1
