# ─────────────────────────────────────────────────────────────
# 环境变量模板
#
# 用法：
#   cp .env.example .env      # 然后填入真实值
#   npm start                 # 会自动加载 .env（无需 export）
#
# ⚠️ .env 已被 .gitignore 忽略 —— 绝不要提交真实 Key。
# ─────────────────────────────────────────────────────────────

# 高德「Web 服务」类型 Key（申请步骤见 docs/nav-backend.md §3.2）
# 注意：平台的「服务平台」必须选【Web 服务】，选错会返回 10009/10001
AMAP_KEY=

# 客户端访问本网关的令牌（不是高德的东西，自己生成即可）
# 生成：node -e "console.log(crypto.randomUUID())"
GATEWAY_TOKEN=

# 监听地址。默认 127.0.0.1 = **只回环**（刻意的安全默认值）：
#   - 反向代理 / 隧道终止 TLS 时，用默认值即可（公网流量进不来，无法绕过代理直连）
#   - 只有网关自己要直接对外（无代理、无隧道）时才设 0.0.0.0
# 详见 DEPLOY.md §四
# HOST=127.0.0.1

# 可选（以下为默认值，通常不用改）
# PORT=8080
# 反向代理跳数；同机反代可设 1（默认 0 = 不信任 X-Forwarded-For）
# TRUST_PROXY=0
# RATE_LIMIT_PER_MIN=60
# UPSTREAM_TIMEOUT_MS=8000
# 地图瓦片缓存目录（需可写；已 gitignore）
# MAP_CACHE_DIR=.cache/map-tiles
# VERBOSE_ERRORS=1
