{
  "name": "car-dashboard-nav-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "导航网关：为 iPhone 侧代理高德 Web 服务（Key 只在服务端）",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "probe": "node --env-file-if-exists=.env bin/probe.js",
    "probe:new": "node --env-file-if-exists=.env bin/probe-new.js"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2"
  }
}
