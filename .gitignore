# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Arduino IDE / arduino-cli 构建产物
firmware/**/build/
*.hex
*.uf2
*.partition.csv.tmp

# 编译中间文件
*.o
*.d
*.a
*.elf
*.bin.map

# 参考仓库（体积大，按需另行克隆，见 docs/setup-macos.md）
# 如需将官方仓库纳入版本管理可注释掉下一行
reference/

# 模拟器
simulator/deps/
simulator/build/
simulator/dashboard_sim
simulator/screenshot.bmp
simulator/shots/

# 固件目录中的共享源码副本（由 tools/sync_firmware.sh 从 simulator/ui/ 同步生成）
#
# ⚠️ sync_firmware.sh 会复制 simulator/ui/ 下的**所有** .c/.h，
#    因此每新增一个共享层模块，必须同时在此登记（否则会被误提交）。
#    已踩坑：新增 nav.c/nav.h 时漏登记（原规则只含 ui_* 前缀）。
firmware/dashboard/face_report.c
firmware/dashboard/face_report.h
firmware/dashboard/ui_*.c
firmware/dashboard/ui_*.h
firmware/dashboard/gnss_*.c
firmware/dashboard/gnss_*.h
firmware/dashboard/telemetry.c
firmware/dashboard/telemetry.h
firmware/dashboard/control.c
firmware/dashboard/control.h
firmware/dashboard/nav.c
firmware/dashboard/nav.h
firmware/dashboard/nav_parse.c
firmware/dashboard/nav_parse.h
firmware/dashboard/img_indexed.c
firmware/dashboard/img_indexed.h
firmware/dashboard/font_*.c
# 照片 v5 新增的共享纯逻辑（2026-10-26）
firmware/dashboard/pgj.c
firmware/dashboard/pgj.h
firmware/dashboard/photo_list.c
firmware/dashboard/photo_list.h
firmware/dashboard/photo_cmd.c
firmware/dashboard/photo_cmd.h
firmware/dashboard/photo_sync.c
firmware/dashboard/photo_sync.h

# Node（网关）；本项目零依赖，正常不会出现
node_modules/

# ⚠️ 环境变量文件：高德 Key / 网关 token 等同密码，绝不入库
# （保留 .env.example 作为模板，它不含任何真实密钥）
.env
.env.*
!.env.example

# 高德真实响应抓取物：仅供本地核对字段，**不入库**
# （协议 §3.5 禁止直接存储其服务数据；入库的是结构夹具 *-v3.json）
gateway/test/fixtures/*-real.json

# Python 字节码缓存
__pycache__/
*.pyc

# 字体管线中间产物与 Python 库（tools/make_fonts.sh 可重建）
design/assets/fonts/src/
tools/pylibs/

# 临时与日志
*.log
*.tmp
tools/output/

# 密钥/私有配置（如后续有 Wi-Fi 凭据等，勿提交）
secrets/

# 单测编译产物
# 测试编译产物（源码为 tests/test_*.c，产物无扩展名）。
# 原先只列了 test_nmea/test_telemetry，导致 test_control / test_ui_face
# 两个二进制被误提交进仓库（test_nmea 更成了源码已删的孤儿）。
# 改为通配并显式排除源码，避免新增测试时再次漏掉。
tests/test_*
!tests/test_*.c

# Xcode 用户数据 / 构建产物（xcodeproj 本身要提交，便于直接打开）
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/DerivedData/
ios/**/build/

# 设计草稿/临时预览目录：由设计迭代过程反复生成，**全仓库无引用**。
# 需要长期保存的设计稿请放 design/wireframes/（受跟踪）。
# 本地文件保留，只是不再入库 —— 避免 git status 长期变脏。
design/previews/

# 网关地图瓦片缓存：运行时按需下载的 OSM 矢量瓦片（二进制，体积随使用增长）。
# 属于**可再生的运行时缓存**、不是源码 —— 不应入库。
# 原先误提交过两个 .pbf，已用 git rm --cached 移出跟踪（文件在本地保留）。
gateway/.cache/

# ═══════════════════════════════════════════════════════════════════
# 个人流程 / 开发过程文档 —— **不上传 GitHub**，只在本地保留
#
# 说明：这些是给自己（和协作 AI）看的开发过程记录，对外部读者没有价值，
#       所以用 git rm --cached 停止跟踪；文件仍在本地，随时可看。
#
#       想把某个文件重新加回仓库：
#           git add -f <文件>
#           （并从下面删掉对应那行）
# ═══════════════════════════════════════════════════════════════════

# AI 协作用的长期上下文与任务边界（纯个人工作流）
/AI_CONTEXT.md
/docs/ai-task-boundaries.md

# 已归档的历史任务书（早期的 AI 任务拆分，工作已完成）
/docs/archive/

# 开发进度台账与测试历史（个人过程记录）
/PROGRESS.md
/docs/test-results.md
