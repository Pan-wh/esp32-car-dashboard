<!--
  主时钟表盘 v2：iPhone 充电息屏时钟风格（镜像 simulator/ui/ui_clock.c）
  纯黑背景，中文日期在上（弱化），超大极细时间在下。
  注意：编辑器预览为静态草稿（不接真实 RTC 数据）；正式实现以 simulator/ui 为准。
-->
<screen>
    <view style_bg_color="0x000000">
        <!-- 日期 + 星期（次要信息，弱化，时间上方） -->
        <lv_label text="10月10日 星期六" align="center" x="0" y="-60">
            <style name="style_date"/>
        </lv_label>

        <!-- 时间（主数据，超大极细，无前导零如 9:41） -->
        <lv_label text="9:41" align="center" x="0" y="16">
            <style name="style_time"/>
        </lv_label>
    </view>
</screen>
